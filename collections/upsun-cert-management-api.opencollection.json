{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Cert Management API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Cert Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of SSL certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/certificates",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a list of objects representing the SSL certificates\nassociated with a project.\n"
        },
        {
          "info": {
            "name": "Add an SSL certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{schemes}://api.upsun.com/projects/:projectId/certificates",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a single SSL certificate to a project.\n"
        },
        {
          "info": {
            "name": "Get an SSL certificate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/certificates/:certificateId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve information about a single SSL certificate\nassociated with a project.\n"
        },
        {
          "info": {
            "name": "Update an SSL certificate",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/projects/:projectId/certificates/:certificateId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a single SSL certificate associated with a project.\n"
        },
        {
          "info": {
            "name": "Delete an SSL certificate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{schemes}://api.upsun.com/projects/:projectId/certificates/:certificateId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificateId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single SSL certificate associated with a project.\n"
        },
        {
          "info": {
            "name": "list-projects-provisioners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/provisioners",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "get-projects-provisioners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/provisioners/:certificateProvisionerDocumentId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificateProvisionerDocumentId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "update-projects-provisioners",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/projects/:projectId/provisioners/:certificateProvisionerDocumentId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificateProvisionerDocumentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}