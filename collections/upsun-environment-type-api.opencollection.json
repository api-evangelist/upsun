{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Environment Type API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Environment Type",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get environment types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/environment-types",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all available environment types"
        },
        {
          "info": {
            "name": "Get environment type links",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/environment-types/:environmentTypeId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentTypeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists the endpoints used to retrieve info about the environment type."
        }
      ]
    }
  ],
  "bundled": true
}