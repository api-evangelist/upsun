{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Third-Party Integrations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Third-Party Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of existing integrations for a project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/integrations",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get list of existing integrations for a project"
        },
        {
          "info": {
            "name": "Integrate project with a third-party service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{schemes}://api.upsun.com/projects/:projectId/integrations",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Integrate project with a third-party service"
        },
        {
          "info": {
            "name": "Get information about an existing third-party integration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/projects/:projectId/integrations/:integrationId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get information about an existing third-party integration"
        },
        {
          "info": {
            "name": "Update an existing third-party integration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/projects/:projectId/integrations/:integrationId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing third-party integration"
        },
        {
          "info": {
            "name": "Delete an existing third-party integration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{schemes}://api.upsun.com/projects/:projectId/integrations/:integrationId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an existing third-party integration"
        }
      ]
    }
  ],
  "bundled": true
}