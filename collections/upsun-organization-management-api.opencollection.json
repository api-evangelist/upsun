{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Organization Management API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Estimate total spend",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/organizations/:organization_id/estimate",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The ID of the organization.<br>\nPrefix with name= to retrieve the organization by name instead.\n"
              }
            ]
          },
          "docs": "Estimates the total spend for the specified organization."
        },
        {
          "info": {
            "name": "Get billing alert configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/organizations/:organization_id/alerts/billing",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The ID of the organization.<br>\nPrefix with name= to retrieve the organization by name instead.\n"
              }
            ]
          },
          "docs": "Retrieves billing alert configuration for the specified organization."
        },
        {
          "info": {
            "name": "Update billing alert configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/organizations/:organization_id/alerts/billing",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The ID of the organization.<br>\nPrefix with name= to retrieve the organization by name instead.\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates billing alert configuration for the specified organization."
        },
        {
          "info": {
            "name": "Get organization prepayment information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/organizations/:organization_id/prepayment",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The ID of the organization."
              }
            ]
          },
          "docs": "Retrieves prepayment information for the specified organization, if applicable."
        },
        {
          "info": {
            "name": "List organization prepayment transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/organizations/:organization_id/prepayment/transactions",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "The ID of the organization."
              }
            ]
          },
          "docs": "Retrieves a list of prepayment transactions for the specified organization, if applicable."
        }
      ]
    }
  ],
  "bundled": true
}