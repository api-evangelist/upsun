{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons SSH Keys API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "SSH Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an SSH key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/ssh_keys/:key_id",
            "params": [
              {
                "name": "key_id",
                "value": "",
                "type": "path",
                "description": "The ID of the ssh key."
              }
            ]
          },
          "docs": "Get an SSH key"
        },
        {
          "info": {
            "name": "Delete an SSH key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{schemes}://api.upsun.com/ssh_keys/:key_id",
            "params": [
              {
                "name": "key_id",
                "value": "",
                "type": "path",
                "description": "The ID of the ssh key."
              }
            ]
          },
          "docs": "Delete an SSH key"
        },
        {
          "info": {
            "name": "Add a new public SSH key to a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{schemes}://api.upsun.com/ssh_keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new public SSH key to a user"
        }
      ]
    }
  ],
  "bundled": true
}