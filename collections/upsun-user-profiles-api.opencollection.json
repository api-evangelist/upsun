{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons User Profiles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/profiles"
          },
          "docs": "List user profiles"
        },
        {
          "info": {
            "name": "Get a single user profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/profiles/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The UUID of the user"
              }
            ]
          },
          "docs": "Get a single user profile"
        },
        {
          "info": {
            "name": "Update a user profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/profiles/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The UUID of the user"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user profile, supplying one or more key/value pairs to to change."
        },
        {
          "info": {
            "name": "Get a user address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/profiles/:userId/address",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The UUID of the user"
              }
            ]
          },
          "docs": "Get a user address"
        },
        {
          "info": {
            "name": "Update a user address",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/profiles/:userId/address",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The UUID of the user"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user address, supplying one or more key/value pairs to to change."
        },
        {
          "info": {
            "name": "Create a user profile picture",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{schemes}://api.upsun.com/profile/:uuid/picture",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The uuid of the user"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a user profile picture"
        },
        {
          "info": {
            "name": "Delete a user profile picture",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{schemes}://api.upsun.com/profile/:uuid/picture",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The uuid of the user"
              }
            ]
          },
          "docs": "Delete a user profile picture"
        }
      ]
    }
  ],
  "bundled": true
}