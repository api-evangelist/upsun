{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Connections API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List federated login connections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/users/:user_id/connections",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The ID of the user."
              }
            ]
          },
          "docs": "Retrieves a list of connections associated with a single user."
        },
        {
          "info": {
            "name": "Get a federated login connection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/users/:user_id/connections/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "The name of the federation provider."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The ID of the user."
              }
            ]
          },
          "docs": "Retrieves the specified connection."
        },
        {
          "info": {
            "name": "Delete a federated login connection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{schemes}://api.upsun.com/users/:user_id/connections/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "The name of the federation provider."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The ID of the user."
              }
            ]
          },
          "docs": "Deletes the specified connection."
        }
      ]
    }
  ],
  "bundled": true
}