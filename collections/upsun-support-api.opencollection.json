{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsun.com Rest Add-ons Support API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.api.platform.sh/oauth2/authorize",
      "accessTokenUrl": "https://auth.api.platform.sh/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Support",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new support ticket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{schemes}://api.upsun.com/tickets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new support ticket"
        },
        {
          "info": {
            "name": "Update a ticket",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{schemes}://api.upsun.com/tickets/:ticket_id",
            "params": [
              {
                "name": "ticket_id",
                "value": "",
                "type": "path",
                "description": "The ID of the ticket"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a ticket"
        },
        {
          "info": {
            "name": "List support ticket priorities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/tickets/priority",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "query",
                "description": "The ID of the subscription the ticket should be related to"
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "The category of the support ticket."
              }
            ]
          },
          "docs": "List support ticket priorities"
        },
        {
          "info": {
            "name": "List support ticket categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{schemes}://api.upsun.com/tickets/category",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "query",
                "description": "The ID of the subscription the ticket should be related to"
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "The ID of the organization the ticket should be related to"
              }
            ]
          },
          "docs": "List support ticket categories"
        }
      ]
    }
  ],
  "bundled": true
}